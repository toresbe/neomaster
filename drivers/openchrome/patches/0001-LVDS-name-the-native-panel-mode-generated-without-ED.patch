From d7767fe3d83d3a24b71e132744d88a8a2da94202 Mon Sep 17 00:00:00 2001
From: neomaster <neomaster@invalid>
Date: Sat, 28 Nov 2026 01:06:21 +0000
Subject: [PATCH 1/3] LVDS: name the native panel mode generated without EDID

On a panel without EDID, via_lvds_get_modes() builds the native mode
with xf86CVTMode(). On Debian bookworm's Xorg 21.1.7 that mode has no
name, and xf86ProbeOutputModes() then segfaults in strcmp() while it
prunes duplicate modes (inlined xf86SortModes). Seen on a CX700 with an
LVDS panel and no DDC (BeoMaster 5). Name the mode with
xf86SetModeDefaultName(), which frees any existing name.
---
 src/via_fp.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/via_fp.c b/src/via_fp.c
index dea6ec9..ae53b7b 100644
--- a/src/via_fp.c
+++ b/src/via_fp.c
@@ -1362,6 +1362,13 @@ via_lvds_get_modes(xf86OutputPtr output)
                 }
 
                 if (pDisplay_Mode) {
+                    /*
+                     * xf86CVTMode() leaves the mode unnamed on some X
+                     * servers (seen on Debian's 21.1.7). A NULL name makes
+                     * xf86ProbeOutputModes() crash in strcmp() when it
+                     * sorts the probed modes. Always give it a name.
+                     */
+                    xf86SetModeDefaultName(pDisplay_Mode);
                     pDisplay_Mode->CrtcHDisplay = pDisplay_Mode->HDisplay;
                     pDisplay_Mode->CrtcHSyncStart = pDisplay_Mode->HSyncStart;
                     pDisplay_Mode->CrtcHSyncEnd = pDisplay_Mode->HSyncEnd;
