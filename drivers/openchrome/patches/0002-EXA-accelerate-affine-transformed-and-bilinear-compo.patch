+/*
+ * Give a texture unit set up with setTexture an affine Render transform
+ * (or NULL) and choose nearest or bilinear filtering for it. The transform
+ * is applied to the texture coordinates in emitQuad, so it must stay valid
+ * until the last emitQuad of the operation.
+ *
+ * clipWidth/clipHeight: for a picture without repeat, its size. emitQuad
+ * then only draws where the transformed coordinates fall inside it. Pass 0
+ * for a repeating picture.
+ */
+static void
+viaSet3DTexTransform(Via3DState * v3d, int tex, PictTransformPtr transform,
+                     Bool bilinear, int clipWidth, int clipHeight)
+{
+    ViaTextureUnit *vTex = v3d->tex + tex;
+    CARD32 filter = 0;
+
+    if (bilinear)
+        filter = (HC_HTXnFLSe_Linear | HC_HTXnFLSs_Linear |
+                  HC_HTXnFLTe_Linear | HC_HTXnFLTs_Linear);
+
+    if (filter != vTex->textureFilter)
+        vTex->textureDirty = TRUE;
+    vTex->textureFilter = filter;
+    vTex->transform = transform;
+    vTex->clipWidth = clipWidth;
+    vTex->clipHeight = clipHeight;
+}
+
 static void
