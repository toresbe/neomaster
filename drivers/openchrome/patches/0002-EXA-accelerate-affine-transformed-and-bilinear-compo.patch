+/*
+ * Clip a convex polygon to the half-plane a*x + b*y + c >= 0
+ * (Sutherland-Hodgman). Returns the new vertex count.
+ */
+static int
+viaClipPolygon(int n, float *x, float *y, double a, double b, double c)
+{
+    float ox[VIA_MAX_POLY], oy[VIA_MAX_POLY];
+    double d0, d1, f;
+    int i, j, m = 0;
+
+    for (i = 0; i < n; ++i) {
+        j = (i + 1) % n;
+        d0 = a * x[i] + b * y[i] + c;
+        d1 = a * x[j] + b * y[j] + c;
+        if (d0 >= 0 && m < VIA_MAX_POLY) {
+            ox[m] = x[i];
+            oy[m++] = y[i];
+        }
+        if ((d0 >= 0) != (d1 >= 0) && m < VIA_MAX_POLY) {
+            f = d0 / (d0 - d1);
+            ox[m] = x[i] + f * (x[j] - x[i]);
+            oy[m++] = y[i] + f * (y[j] - y[i]);
+        }
     }
+    memcpy(x, ox, m * sizeof(float));
+    memcpy(y, oy, m * sizeof(float));
+    return m;
+}
+
+static void
+via3DEmitQuad(Via3DState * v3d, ViaCommandBuffer * cb, int dstX, int dstY,
+              int src0X, int src0Y, int src1X, int src1Y, int w, int h)
+{
+    /* Two triangles over the corners top-left, top-right, bottom-left,
+     * bottom-right. This is the order the driver has always used. */
+    static const int quadOrder[6] = { 0, 1, 2, 2, 1, 3 };
+    float s[VIA_NUM_TEXUNITS][VIA_MAX_POLY], t[VIA_NUM_TEXUNITS][VIA_MAX_POLY];
+    float x[VIA_MAX_POLY], y[VIA_MAX_POLY];
+    int order[3 * (VIA_MAX_POLY - 2)];
